# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Phase 1 — X (Twitter) API v2. Reading user timelines needs a paid tier (Basic or above).
X_BEARER_TOKEN=

# Phase 2 — Anthropic
ANTHROPIC_API_KEY=

# Phase 3 — Option A: HeyGen (recommended: one API does voice + avatar)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Phase 3 — Option B: ElevenLabs (voice) + D-ID (video)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DID_API_KEY=
DID_PRESENTER_ID=

# Phase 1 (Gmail newsletters) + Phase 5 (YouTube upload) — one Google OAuth "Desktop app" client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
YOUTUBE_REFRESH_TOKEN=
